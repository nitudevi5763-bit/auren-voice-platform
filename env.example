# LiveKit Cloud - from cloud.livekit.io project settings
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram - deepgram.com, for speech-to-text
DEEPGRAM_API_KEY=

# ElevenLabs - elevenlabs.io, for text-to-speech
ELEVENLABS_API_KEY=

# Groq - console.groq.com, free + fast LLM brain
GROQ_API_KEY=

# Plivo - plivo.com, for the phone number / SIP trunk (used later, not in Chunk 1)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
